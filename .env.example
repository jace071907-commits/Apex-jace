# ---------------------------------------------------------------
# APEX environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. On Vercel, add these under
# Project Settings -> Environment Variables.
# ---------------------------------------------------------------

# Project Pends (hosts "User", "Pend", "UserSettings" + Supabase Auth)
# Base project URL only - no /rest/v1/ suffix.
NEXT_PUBLIC_SUPABASE_URL=https://exsyzehbaxmtkkttrnmg.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# SERVER ONLY - secret key (sb_secret_...) or legacy service_role key of Project Pends.
# Used exclusively in API routes / server components to read the
# User table and manage Supabase Auth users. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# SERVER ONLY - long random string (min 32 chars) used to derive the
# internal Supabase Auth credential for each user.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APEX_AUTH_SECRET=replace-with-a-long-random-secret

# Business time zone for "today" (Date Pended, Last Date Update, aging). IANA name.
NEXT_PUBLIC_APEX_TIME_ZONE=America/New_York

# APEX Application Database project (future APEX modules)
NEXT_PUBLIC_APEX_APP_SUPABASE_URL=https://exsyzehbaxmtkkttrnmg.supabase.co
NEXT_PUBLIC_APEX_APP_SUPABASE_ANON_KEY=your-app-db-anon-key
